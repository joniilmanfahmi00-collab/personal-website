---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current = 'dashboard' } = Astro.props;

const navGroups = [
  {
    label: 'Eusi Situs',
    items: [
      { id: 'blog', label: 'Tulisan', href: '/keystatic/branch/main/collection/blog', icon: 'T' },
      { id: 'portfolio', label: 'Portofolio', href: '/keystatic/branch/main/collection/portfolio', icon: 'P' },
      { id: 'certificates', label: 'Sertifikat', href: '/keystatic/branch/main/collection/certificates', icon: 'S' },
    ],
  },
  {
    label: 'Profil & Pangaturan',
    items: [
      { id: 'bio', label: 'Biodata & Biografi', href: '/keystatic/branch/main/singleton/bio', icon: 'B' },
      { id: 'seo', label: 'SEO', href: '/keystatic/branch/main/singleton/seoSettings', icon: '↗' },
      { id: 'comments', label: 'Komentar Giscus', href: '/admin/komentar', icon: 'K' },
    ],
  },
];
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={`${title} | Joni Website`} description={description} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-[#F3F5F7] font-sans text-slate-900 antialiased dark:bg-[#0B1220] dark:text-slate-100">
    <div class="min-h-screen md:flex">
      <aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col bg-[#111C2D] px-4 py-5 text-white md:flex">
        <a href="/admin" class="mb-8 flex items-center gap-3 rounded-xl px-2 py-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7BB4D1]">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#E8935B] font-bevan text-lg text-[#111C2D]">J</span>
          <span>
            <span class="block font-bevan text-sm">Joni Website</span>
            <span class="mt-0.5 block font-mono text-[10px] uppercase tracking-[0.16em] text-slate-400">Panel Admin</span>
          </span>
        </a>

        <nav aria-label="Navigasi panel" class="flex-1 space-y-6">
          <div>
            <p class="mb-2 px-3 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">Ringkesan</p>
            <a
              href="/admin"
              class:list={[
                'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors',
                current === 'dashboard' ? 'bg-[#1B4B66] text-white shadow-sm' : 'text-slate-300 hover:bg-white/10 hover:text-white',
              ]}
              aria-current={current === 'dashboard' ? 'page' : undefined}
            >
              <span class:list={['flex h-7 w-7 items-center justify-center rounded-lg text-xs font-bold', current === 'dashboard' ? 'bg-white/15' : 'bg-white/10 text-[#E8A16F]']} aria-hidden="true">D</span>
              Dasbor
            </a>
          </div>

          {navGroups.map((group) => (
            <div>
              <p class="mb-2 px-3 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">{group.label}</p>
              <div class="space-y-1">
                {group.items.map((item) => {
                  const active = current === item.id;
                  return (
                    <a
                      href={item.href}
                      class:list={[
                        'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors',
                        active ? 'bg-[#1B4B66] text-white shadow-sm' : 'text-slate-300 hover:bg-white/10 hover:text-white',
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      <span
                        class:list={[
                          'flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-xs font-bold',
                          active ? 'bg-white/15 text-white' : 'bg-white/10 text-[#E8A16F] group-hover:bg-white/15',
                        ]}
                        aria-hidden="true"
                      >
                        {item.icon}
                      </span>
                      {item.label}
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </nav>

        <a href="/" class="mt-6 flex items-center gap-2 rounded-xl border border-white/10 px-3 py-3 text-xs font-semibold text-slate-300 transition-colors hover:border-[#E8935B]/50 hover:text-white">
          <span aria-hidden="true">↗</span> Tingali situs
        </a>
      </aside>

      <div class="min-w-0 flex-1 md:pl-64">
        <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/90 backdrop-blur-md dark:border-slate-800 dark:bg-[#0B1220]/90">
          <div class="mx-auto flex min-h-16 max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
              <details class="relative md:hidden">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold dark:border-slate-700">
                  <span aria-hidden="true">☰</span> Menu
                </summary>
                <nav aria-label="Navigasi panel mobile" class="absolute left-0 top-12 z-40 w-72 rounded-2xl border border-slate-200 bg-[#111C2D] p-4 text-white shadow-xl dark:border-slate-700">
                  <a href="/admin" class="mb-4 block rounded-lg bg-white/10 px-3 py-2.5 text-sm font-semibold">Dasbor</a>
                  {navGroups.map((group) => (
                    <div class="mb-4 last:mb-0">
                      <p class="mb-2 px-2 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">{group.label}</p>
                      <div class="space-y-1">
                        {group.items.map((item) => {
                          const active = current === item.id;
                          return (
                            <a
                              href={item.href}
                              class:list={[
                                'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors',
                                active ? 'bg-[#1B4B66] text-white shadow-sm' : 'text-slate-300 hover:bg-white/10 hover:text-white',
                              ]}
                              aria-current={active ? 'page' : undefined}
                            >
                              <span
                                class:list={[
                                  'flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-xs font-bold',
                                  active ? 'bg-white/15 text-white' : 'bg-white/10 text-[#E8A16F] group-hover:bg-white/15',
                                ]}
                                aria-hidden="true"
                              >
                                {item.icon}
                              </span>
                              {item.label}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                  <a href="/" class="mt-3 block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-300 hover:bg-white/10 hover:text-white">Tingali situs</a>
                </nav>
              </details>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400">Panel admin</p>
                <p class="text-sm font-bold">{title}</p>
              </div>
            </div>
            <a href="/keystatic" class="inline-flex items-center gap-2 rounded-lg bg-[#1B4B66] px-3.5 py-2.5 text-xs font-bold text-white transition hover:bg-[#153a50] sm:px-4 sm:text-sm">
              Buka Keystatic <span aria-hidden="true">↗</span>
            </a>
          </div>
        </header>

        <main class="mx-auto w-full max-w-[1440px] px-4 py-7 sm:px-6 sm:py-9 lg:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
