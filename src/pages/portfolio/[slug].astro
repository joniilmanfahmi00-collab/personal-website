---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/MainLayouts.astro';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects
    .filter((project) => !project.data.draft)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const date = project.data.pubDate
  ? new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(project.data.pubDate)
  : null;
---

<Layout title={`${project.data.title} — Portofolio Joni Ilman Pahmi`} description={project.data.summary}>
  <article class="bg-[#F7F5F0] py-16 transition-colors duration-300 dark:bg-[#0B1220] sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="transition-colors hover:text-[#E8935B]">Beranda</a></li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li><a href="/portfolio" class="transition-colors hover:text-[#E8935B]">Portofolio</a></li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li aria-current="page" class="font-semibold text-[#1B4B66] dark:text-[#7BB4D1]">{project.data.title}</li>
        </ol>
      </nav>

      <header class="mb-8">
        <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-[#E8935B]">{project.data.category}</p>
        <h1 class="font-bevan text-3xl font-extrabold leading-tight tracking-tight text-[#0F172A] dark:text-white sm:text-4xl md:text-5xl">{project.data.title}</h1>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-600 dark:text-slate-300">
          {project.data.client && <span>{project.data.client}</span>}
          {project.data.client && date && <span aria-hidden="true" class="text-slate-400">•</span>}
          {date && <time datetime={project.data.pubDate?.toISOString()}>{date}</time>}
        </div>
      </header>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/50">
        <img src={project.data.image || '/hero.jpg'} alt={project.data.title} class="h-64 w-full object-cover sm:h-80 md:h-96" loading="eager" />
      </div>

      <p class="mt-8 text-lg leading-relaxed text-slate-700 dark:text-slate-300">{project.data.summary}</p>

      {project.data.stack.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {project.data.stack.map((tech) => <span class="rounded-md bg-[#1B4B66]/10 px-3 py-1.5 text-xs font-mono font-semibold uppercase tracking-wider text-[#1B4B66] dark:bg-[#7BB4D1]/10 dark:text-[#7BB4D1]">{tech}</span>)}
        </div>
      )}

      {(project.data.liveUrl || project.data.repoUrl) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {project.data.liveUrl && <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-[#E8935B] px-5 py-3 text-sm font-semibold text-[#0F172A] transition hover:bg-[#DB7F3F]">Lihat proyek live</a>}
          {project.data.repoUrl && <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-[#1B4B66] transition hover:border-[#1B4B66] dark:border-slate-600 dark:text-[#7BB4D1]">Lihat kode sumber</a>}
        </div>
      )}

      <div class="prose prose-slate mt-10 max-w-none rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 prose-headings:font-bevan prose-headings:text-[#0F172A] prose-a:text-[#1B4B66] prose-img:rounded-2xl dark:prose-invert dark:bg-slate-800/50 dark:ring-slate-700 dark:prose-headings:text-white dark:prose-a:text-[#7BB4D1] sm:p-8">
        <Content />
      </div>

      <div class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-700">
        <a href="/portfolio" class="inline-flex items-center gap-2 text-sm font-semibold text-[#1B4B66] transition-colors hover:text-[#E8935B] dark:text-[#7BB4D1]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
          Kembali ke semua proyek
        </a>
      </div>
    </div>
  </article>
</Layout>
