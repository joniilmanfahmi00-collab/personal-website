---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/MainLayouts.astro';
import { getReadingTimeMinutes } from '../../utils/readingTime';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageSize = 6;
const categories = ['Semua', ...new Set(posts.map((post) => post.data.category))];
const siteTitle = 'Blog Joni Ilman Pahmi';
const siteDescription = 'Tulisan tentang web development, tutorial, opini, dan pengalaman digital.';
---

<Layout title={siteTitle} description={siteDescription}>
  <section class="bg-[#F7F5F0] dark:bg-[#0B1220] py-16 sm:py-20 relative overflow-hidden transition-colors duration-300">
    <div class="blueprint-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-[#E8935B] transition-colors">Beranda</a></li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li aria-current="page" class="text-[#1B4B66] dark:text-[#7BB4D1] font-semibold">Blog</li>
        </ol>
      </nav>

      <div class="mb-10 max-w-3xl">
        <p class="font-mono text-xs font-semibold text-[#E8935B] tracking-wider mb-2 uppercase">// blog/index.md</p>
        <h1 class="font-bevan text-3xl sm:text-4xl md:text-5xl font-extrabold text-[#0F172A] dark:text-white tracking-tight">
          Tulisan & <span class="text-[#1B4B66] dark:text-[#7BB4D1]">Catatan</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          Berbagi pengalaman, tutorial, dan sudut pandang seputar pengembangan web, produk digital, dan praktik kerja yang sehat.
        </p>
      </div>

      <div class="mb-8 flex flex-col gap-4">
        <label class="relative block">
          <span class="sr-only">Cari artikel</span>
          <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/></svg>
          <input id="blog-search" type="search" placeholder="Cari artikel, topik, atau tag..." class="w-full rounded-xl border border-slate-200 bg-white px-11 py-3 text-sm text-slate-700 shadow-sm outline-none transition focus:border-[#1B4B66] focus:ring-2 focus:ring-[#1B4B66]/10 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
        </label>

        <div class="flex flex-wrap gap-3">
          {categories.map((kat, index) => (
            <button
              type="button"
              data-blog-filter={kat}
              data-active={index === 0 ? 'true' : 'false'}
              class="blog-filter px-5 py-2 rounded-full text-sm font-semibold border transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B4B66]"
            >
              {kat}
            </button>
          ))}
        </div>
      </div>

      <div class="mb-6 flex items-center justify-between gap-3 text-sm text-slate-500 dark:text-slate-400">
        <p id="blog-results-meta">Menampilkan {posts.length} artikel</p>
      </div>

      <div id="blog-grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {posts.map((post) => {
          const slug = post.id.replace(/\.(md|mdx)$/i, '');
          const url = `/blog/${slug}`;
          const date = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.pubDate);
          const readingTime = `${getReadingTimeMinutes(post.body)} menit baca`;

          return (
            <article data-blog-category={post.data.category} data-blog-title={post.data.title.toLowerCase()} data-blog-description={post.data.description.toLowerCase()} data-blog-tags={post.data.tags.join(' ').toLowerCase()} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-slate-700 dark:bg-slate-800/50">
              <div class="mb-4 overflow-hidden rounded-xl">
                <img src={post.data.image || '/hero.jpg'} alt={post.data.title} class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              </div>

              <div class="mb-3 flex items-center justify-between gap-3 text-xs font-mono text-slate-500 dark:text-slate-400">
                <span>{post.data.category}</span>
                <span>{date}</span>
              </div>

              <h2 class="text-xl font-bold text-[#0F172A] dark:text-white leading-snug">
                <a href={url} class="hover:text-[#E8935B] transition-colors">{post.data.title}</a>
              </h2>

              <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300 flex-1">
                {post.data.description}
              </p>

              <div class="mt-5 flex items-center justify-between gap-3">
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">{readingTime}</span>
                <a href={url} class="inline-flex items-center gap-2 font-semibold text-[#1B4B66] dark:text-[#7BB4D1] hover:text-[#E8935B] transition-colors">
                  Baca selengkapnya
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <div id="blog-pagination" class="mt-10 hidden items-center justify-center gap-3"></div>
      <p id="blog-empty" class="hidden py-8 text-center text-sm text-slate-500 dark:text-slate-400 font-mono">// Tidak ada artikel dalam kategori ini.</p>
    </div>
  </section>

  <style>
    .blog-filter {
      background: rgba(255, 255, 255, 0.7);
      border-color: rgba(148, 163, 184, 0.55);
      color: #334155;
    }

    .blog-filter[data-active='true'] {
      background: #1B4B66;
      border-color: #1B4B66;
      color: white;
      box-shadow: 0 12px 24px rgba(27, 75, 102, 0.18);
    }

    :global(.dark) .blog-filter {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(100, 116, 139, 0.7);
      color: #dbeafe;
    }

    :global(.dark) .blog-filter[data-active='true'] {
      background: #7BB4D1;
      border-color: #7BB4D1;
      color: #0f172a;
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-category]'));
      const emptyMsg = document.getElementById('blog-empty');
      const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
      const paginationWrap = document.getElementById('blog-pagination');
      const resultsMeta = document.getElementById('blog-results-meta');

    const pageSize = 6;
    let currentFilter = 'Semua';
    let currentPage = 1;

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      const filtered = cards.filter((card) => {
        const category = card.getAttribute('data-blog-category') ?? '';
        const title = (card.getAttribute('data-blog-title') ?? '').toLowerCase();
        const description = (card.getAttribute('data-blog-description') ?? '').toLowerCase();
        const tags = (card.getAttribute('data-blog-tags') ?? '').toLowerCase();
        const matchesCategory = currentFilter === 'Semua' || category === currentFilter;
        const matchesSearch = !query || `${title} ${description} ${tags}`.includes(query);
        return matchesCategory && matchesSearch;
      });

      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);

      cards.forEach((card) => {
        const category = card.getAttribute('data-blog-category') ?? '';
        const title = (card.getAttribute('data-blog-title') ?? '').toLowerCase();
        const description = (card.getAttribute('data-blog-description') ?? '').toLowerCase();
        const tags = (card.getAttribute('data-blog-tags') ?? '').toLowerCase();
        const queryValue = (searchInput?.value ?? '').trim().toLowerCase();
        const showByFilter = currentFilter === 'Semua' || category === currentFilter;
        const showBySearch = !queryValue || `${title} ${description} ${tags}`.includes(queryValue);
        const pageIndex = filtered.indexOf(card);
        const showByPage = pageIndex >= (currentPage - 1) * pageSize && pageIndex < currentPage * pageSize;
        card.style.display = showByFilter && showBySearch && showByPage ? '' : 'none';
      });

      if (resultsMeta) {
        const label = filtered.length === 1 ? 'artikel' : 'artikel';
        resultsMeta.textContent = `Menampilkan ${filtered.length} ${label}`;
      }

      if (paginationWrap) {
        paginationWrap.classList.toggle('hidden', filtered.length <= pageSize);
        paginationWrap.innerHTML = '';

        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.textContent = 'Sebelumnya';
        prevBtn.disabled = currentPage === 1;
        prevBtn.className = 'rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 disabled:opacity-40 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200';
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage -= 1;
            applyFilters();
          }
        });

        const pageInfo = document.createElement('span');
        pageInfo.textContent = `Halaman ${currentPage} / ${totalPages}`;
        pageInfo.className = 'text-sm font-semibold text-slate-600 dark:text-slate-300';

        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.textContent = 'Berikutnya';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.className = 'rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 disabled:opacity-40 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200';
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage += 1;
            applyFilters();
          }
        });

        paginationWrap.append(prevBtn, pageInfo, nextBtn);
      }

      if (emptyMsg) {
        emptyMsg.classList.toggle('hidden', filtered.length !== 0);
      }
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        currentFilter = button.getAttribute('data-blog-filter') ?? 'Semua';
        currentPage = 1;
        buttons.forEach((btn) => {
          const active = btn === button;
          btn.setAttribute('data-active', String(active));
        });
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      currentPage = 1;
      applyFilters();
    });

      applyFilters();
    });
  </script>
</Layout>
