---
import '../../styles/global.css';
import {Icon} from  'astro-icon/components';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/MainLayouts.astro';
import { getReadingTimeMinutes } from '../../utils/readingTime';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => {
      const slug = post.id.replace(/\.(md|mdx)$/i, '');
      return {
        params: { slug },
        props: { post },
      };
    });
}

const { post } = Astro.props;
const { Content } = await render(post);
const postSlug = post.id.split('/').map(encodeURIComponent).join('/');
const siteUrl = Astro.site ?? new URL('https://joniilmanpahmi.online');
const postUrl = new URL(`/blog/${postSlug}`, siteUrl).href;
const authorUrl = post.data.author === 'Joni Ilman Pahmi' ? new URL('/bio', siteUrl).href : undefined;
const readingTime = `${getReadingTimeMinutes(post.body)} menit baca`;
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': post.data.schemaType ?? 'NewsArticle',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    ...(authorUrl ? { url: authorUrl } : {}),
  },
  publisher: {
    '@type': 'Person',
    name: 'Joni Ilman Pahmi',
    url: new URL('/bio', siteUrl).href,
  },
  articleSection: post.data.category,
  inLanguage: 'id-ID',
};
if (post.data.image) articleSchema.image = [new URL(post.data.image, siteUrl).href];
if (post.data.tags.length) articleSchema.keywords = post.data.tags;
const articleSchemaJson = JSON.stringify(articleSchema).replace(/</g, '\\u003c');
const giscus = {
  clientUrl: import.meta.env.PUBLIC_GISCUS_CLIENT_URL,
  repo: import.meta.env.PUBLIC_GISCUS_REPO,
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID,
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY,
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID,
  mapping: import.meta.env.PUBLIC_GISCUS_MAPPING,
  strict: import.meta.env.PUBLIC_GISCUS_STRICT,
  reactionsEnabled: import.meta.env.PUBLIC_GISCUS_REACTIONS_ENABLED,
  emitMetadata: import.meta.env.PUBLIC_GISCUS_EMIT_METADATA,
  inputPosition: import.meta.env.PUBLIC_GISCUS_INPUT_POSITION,
  themeLight: import.meta.env.PUBLIC_GISCUS_THEME_LIGHT,
  themeDark: import.meta.env.PUBLIC_GISCUS_THEME_DARK,
  lang: import.meta.env.PUBLIC_GISCUS_LANG,
  loading: import.meta.env.PUBLIC_GISCUS_LOADING,
  crossOrigin: import.meta.env.PUBLIC_GISCUS_CROSSORIGIN,
};
const giscusEnabled = Object.values(giscus).every((value) => Boolean(value));
const date = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.pubDate);

const allPosts = (await getCollection('blog')).filter((item) => !item.data.draft && item.id !== post.id);
const relatedPosts = allPosts
  .filter((item) => item.data.category === post.data.category)
  .slice(0, 3);
---

<Layout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={articleSchemaJson} />
  <div class="fixed left-0 top-0 z-50 h-1 w-full bg-slate-200 dark:bg-slate-800">
    <div id="reading-progress" class="h-full bg-linear-to-r from-[#1B4B66] to-[#E8935B]" style="width: 0%"></div>
  </div>

  <article class="bg-[#F7F5F0] dark:bg-[#0B1220] py-16 sm:py-20 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-[#E8935B] transition-colors">Beranda</a></li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li><a href="/blog" class="hover:text-[#E8935B] transition-colors">Blog</a></li>
          <li aria-hidden="true" class="text-slate-400">/</li>
          <li aria-current="page" class="text-[#1B4B66] dark:text-[#7BB4D1] font-semibold">{post.data.title}</li>
        </ol>
      </nav>

      <header class="mb-8">
        <p class="font-mono text-xs font-semibold text-[#E8935B] tracking-wider mb-3 uppercase">{post.data.category}</p>
        <h1 class="font-bevan text-3xl sm:text-4xl md:text-5xl font-extrabold text-[#0F172A] dark:text-white tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-600 dark:text-slate-300">
          <span>{post.data.author}</span>
          <span class="text-slate-400">•</span>
          <time datetime={post.data.pubDate.toISOString()}>{date}</time>
          <span aria-hidden="true" class="text-slate-400">·</span>
          <span>{readingTime}</span>
        </div>
      </header>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800/50 shadow-sm">
        <img src={post.data.image || '/hero.jpg'} alt={post.data.title} class="h-72 w-full object-cover sm:h-80 md:h-96" loading="eager" />
      </div>

      <div class="prose prose-slate max-w-none mt-10 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 prose-headings:font-bevan prose-h1:text-4xl prose-h2:text-3xl prose-h3:text-2xl prose-img:rounded-2xl prose-a:text-[#1B4B66] dark:prose-invert dark:bg-slate-800/50 dark:ring-slate-700 sm:p-8 dark:prose-a:text-[#7BB4D1]">
        <Content />
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
            #{tag}
          </span>
        ))}
      </div>

      <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-6 dark:border-slate-700 sm:flex-row sm:items-center sm:justify-between">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-[#1B4B66] dark:text-[#7BB4D1] hover:text-[#E8935B] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          Kembali ke Blog
        </a>

        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Share</span>
          <button id="copy-article-link" type="button" data-copy-url={postUrl} aria-label="Salin tautan artikel" title="Salin tautan artikel" class="rounded-full border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <Icon name="tabler:clipboard-copy" width={20} height={20} />
          </button>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke X" title="Bagikan ke X" class="rounded-full border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <Icon name="tabler:brand-twitter" width={20} height={20} />
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke LinkedIn" title="Bagikan ke LinkedIn" class="rounded-full border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <Icon name="tabler:brand-linkedin" width={20} height={20} />
          </a>
          <a href={`https://wa.me/?text=${encodeURIComponent(`${post.data.title} ${postUrl}`)}`} target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke WhatsApp" title="Bagikan ke WhatsApp" class="rounded-full border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <Icon name="tabler:brand-whatsapp" width={20} height={20} />
          </a>
          <a href={`https://www.threads.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke Threads" title="Bagikan ke Threads" class="rounded-full border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <Icon name="tabler:brand-threads" width={20} height={20} />
          </a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke Facebook" title="Bagikan ke Facebook" class="rounded-full border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <Icon name="tabler:brand-facebook" width={20} height={20} />
          </a>
          <span id="share-feedback" role="status" aria-live="polite" class="text-xs font-mono text-slate-500 dark:text-slate-400"></span>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <section class="mt-14">
          <h2 class="mb-6 font-bevan text-2xl text-[#0F172A] dark:text-white">Artikel Terkait</h2>
          <div class="grid gap-5 md:grid-cols-3">
            {relatedPosts.map((item) => {
              const itemSlug = item.id.replace(/\.(md|mdoc)$/i, '');
              const itemDate = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(item.data.pubDate);
              return (
                <a href={`/blog/${itemSlug}`} class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-slate-700 dark:bg-slate-800/50">
                  <div class="mb-3 overflow-hidden rounded-xl">
                    <img src={item.data.image || '/hero.jpg'} alt={item.data.title} class="h-40 w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
                  </div>
                  <p class="text-xs font-mono uppercase tracking-[0.15em] text-[#E8935B]">{item.data.category}</p>
                  <h3 class="mt-2 text-lg font-bold text-[#0F172A] dark:text-white">{item.data.title}</h3>
                  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{itemDate}</p>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {giscusEnabled && (
        <section aria-labelledby="comments-heading" class="mt-14 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800/50 sm:p-8">
          <h2 id="comments-heading" class="mb-5 font-bevan text-2xl text-[#0F172A] dark:text-white">Komentar</h2>
          <div
            class="giscus"
            data-client-url={giscus.clientUrl}
            data-repo={giscus.repo}
            data-repo-id={giscus.repoId}
            data-category={giscus.category}
            data-category-id={giscus.categoryId}
            data-mapping={giscus.mapping}
            data-strict={giscus.strict}
            data-reactions-enabled={giscus.reactionsEnabled}
            data-emit-metadata={giscus.emitMetadata}
            data-input-position={giscus.inputPosition}
            data-theme-light={giscus.themeLight}
            data-theme-dark={giscus.themeDark}
            data-lang={giscus.lang}
            data-loading={giscus.loading}
            data-crossorigin={giscus.crossOrigin}
          ></div>
        </section>
      )}
    </div>
  </article>

  <script>
    let cleanupArticlePage = () => {};
    document.addEventListener('astro:before-swap', () => cleanupArticlePage());
    document.addEventListener('astro:page-load', () => {
      cleanupArticlePage();
      const pageEvents = new AbortController();
      let frameObserver: MutationObserver | undefined;
      let pageThemeObserver: MutationObserver | undefined;
      let feedbackTimeout: number | undefined;

      const progressBar = document.getElementById('reading-progress');
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) progressBar.style.width = `${Math.min(Math.max(progress, 0), 100)}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true, signal: pageEvents.signal });
      updateProgress();

      const copyLinkButton = document.getElementById('copy-article-link');
      const shareFeedback = document.getElementById('share-feedback');
      copyLinkButton?.addEventListener('click', async () => {
        const shareUrl = copyLinkButton.dataset.copyUrl || window.location.href;
        let copied = false;

        try {
          await navigator.clipboard.writeText(shareUrl);
          copied = true;
        } catch {
          const input = document.createElement('textarea');
          input.value = shareUrl;
          input.setAttribute('readonly', '');
          input.style.position = 'fixed';
          input.style.opacity = '0';
          document.body.appendChild(input);
          input.select();
          copied = document.execCommand('copy');
          input.remove();
        }

        const message = copied ? 'Tautan artikel berhasil disalin.' : 'Tautan gagal disalin.';
        if (shareFeedback) shareFeedback.textContent = message;
        copyLinkButton.title = copied ? 'Tautan disalin' : 'Gagal menyalin tautan';
        copyLinkButton.setAttribute('aria-label', copyLinkButton.title);
        feedbackTimeout = window.setTimeout(() => {
          copyLinkButton.title = 'Salin tautan artikel';
          copyLinkButton.setAttribute('aria-label', 'Salin tautan artikel');
          if (shareFeedback) shareFeedback.textContent = '';
        }, 2200);
      }, { signal: pageEvents.signal });

      const giscusContainer = document.querySelector('.giscus[data-client-url]');
      if (giscusContainer instanceof HTMLElement) {
        const config = giscusContainer.dataset;
        const getGiscusTheme = () => (
          document.documentElement.classList.contains('dark') ? config.themeDark : config.themeLight
        );
        const giscusScript = document.createElement('script');
        giscusScript.src = config.clientUrl ?? '';
        giscusScript.async = true;
        giscusScript.crossOrigin = config.crossorigin || 'anonymous';
        giscusScript.dataset.repo = config.repo ?? '';
        giscusScript.dataset.repoId = config.repoId ?? '';
        giscusScript.dataset.category = config.category ?? '';
        giscusScript.dataset.categoryId = config.categoryId ?? '';
        giscusScript.dataset.mapping = config.mapping ?? '';
        giscusScript.dataset.strict = config.strict ?? '';
        giscusScript.dataset.reactionsEnabled = config.reactionsEnabled ?? '';
        giscusScript.dataset.emitMetadata = config.emitMetadata ?? '';
        giscusScript.dataset.inputPosition = config.inputPosition ?? '';
        giscusScript.dataset.theme = getGiscusTheme() ?? '';
        giscusScript.dataset.lang = config.lang ?? '';
        giscusScript.dataset.loading = config.loading ?? '';

        const giscusOrigin = new URL(giscusScript.src).origin;
        giscusContainer.appendChild(giscusScript);

        let giscusFrame: HTMLIFrameElement | null = null;
        let giscusFrameLoaded = false;
        let appliedTheme = giscusScript.dataset.theme;
        const syncGiscusTheme = () => {
          const nextTheme = getGiscusTheme();
          if (!giscusFrame || !giscusFrameLoaded || !nextTheme || nextTheme === appliedTheme) return;
          giscusFrame.contentWindow?.postMessage(
            { giscus: { setConfig: { theme: nextTheme } } },
            giscusOrigin,
          );
          appliedTheme = nextTheme;
        };

        frameObserver = new MutationObserver(() => {
          const nextFrame = giscusContainer.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
          if (nextFrame === giscusFrame) return;
          giscusFrame = nextFrame;
          giscusFrameLoaded = false;
          giscusFrame?.addEventListener('load', () => {
            giscusFrameLoaded = true;
            syncGiscusTheme();
          }, { signal: pageEvents.signal });
        });
        frameObserver.observe(giscusContainer, { childList: true, subtree: true });

        pageThemeObserver = new MutationObserver(syncGiscusTheme);
        pageThemeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      }

      cleanupArticlePage = () => {
        pageEvents.abort();
        frameObserver?.disconnect();
        pageThemeObserver?.disconnect();
        if (feedbackTimeout !== undefined) window.clearTimeout(feedbackTimeout);
      };
    });
  </script>
</Layout>
