<script>
    // Filter artikel blog berdasarkan kategori.
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('[data-blog-filter]');
        const cards = document.querySelectorAll('[data-blog-category]');
        const emptyMsg = document.getElementById('blog-empty');
        if (!buttons.length || !cards.length) return;
        buttons.forEach((btn) => {
            btn.addEventListener('click', () => {
                const filter = btn.getAttribute('data-blog-filter');
                buttons.forEach((b) => b.setAttribute('data-active', String(b === btn)));
                let visible = 0;
                cards.forEach((card) => {
                    const show = filter === 'Semua' || card.getAttribute('data-blog-category') === filter;
                    card.classList.toggle('hidden', !show);
                    if (show) visible++;
                });
                emptyMsg?.classList.toggle('hidden', visible > 0);
            });
        });
    });
</script>