---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/MainLayouts.astro';

export const prerender = false;

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .map((post) => ({
    path: `/blog/${post.id.replace(/\.(md|mdx)$/i, '')}`,
    title: post.data.title,
  }));
---

<Layout title="Komentar Giscus" description="Maca jeung ngabales komentar blog tina panel admin.">
  <section class="min-h-screen bg-[#F7F5F0] px-4 py-10 text-slate-900 dark:bg-[#0B1220] dark:text-slate-100 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#E8935B]">Panel admin</p>
          <h1 class="font-bevan text-3xl sm:text-4xl">Komentar Giscus</h1>
          <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
            Maca diskusi dina GitHub Discussions sarta ngabalesna tina dieu.
          </p>
        </div>
        <nav class="flex flex-wrap items-center gap-3 text-sm">
          <a href="/keystatic" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:hover:border-[#7BB4D1] dark:hover:text-[#7BB4D1]">← Keystatic</a>
          <a href="/" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold hover:border-[#1B4B66] hover:text-[#1B4B66] dark:border-slate-700 dark:hover:border-[#7BB4D1] dark:hover:text-[#7BB4D1]">Tingali situs</a>
        </nav>
      </div>

      <div id="admin-notice" class="mb-5 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite"></div>

      <section id="admin-login" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8">
        <h2 class="font-bevan text-xl">Asup ku GitHub</h2>
        <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
          Paké akun GitHub admin anu diidinan pikeun ningali jeung ngabales komentar.
        </p>
        <a href="/api/admin/giscus/login" class="mt-5 inline-flex items-center rounded-lg bg-[#1B4B66] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#153a50]">
          Asup ku GitHub
        </a>
      </section>

      <section id="admin-dashboard" class="hidden">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm dark:border-slate-700 dark:bg-slate-900">
          <p>Asup minangka <strong id="admin-login-name"></strong></p>
          <div class="flex items-center gap-2">
            <button id="refresh-discussions" type="button" class="rounded-lg border border-slate-300 px-3 py-2 font-semibold hover:border-[#1B4B66] dark:border-slate-700 dark:hover:border-[#7BB4D1]">Muat deui</button>
            <button id="admin-logout" type="button" class="rounded-lg border border-slate-300 px-3 py-2 font-semibold hover:border-red-500 hover:text-red-600 dark:border-slate-700">Kaluar</button>
          </div>
        </div>

        <div class="grid min-h-[34rem] gap-4 lg:grid-cols-[19rem_minmax(0,1fr)]">
          <aside class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-slate-200 p-4 dark:border-slate-700">
              <h2 class="font-bevan text-lg">Diskusi</h2>
              <label class="mt-3 block">
                <span class="sr-only">Pilarian diskusi</span>
                <input id="discussion-search" type="search" placeholder="Pilarian artikel..." class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-500 focus:border-[#1B4B66] focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
              </label>
            </div>
            <div id="discussion-list" class="max-h-[65vh] overflow-y-auto p-2" role="listbox" aria-label="Daptar diskusi"></div>
          </aside>

          <section id="discussion-detail" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-7" aria-live="polite">
            <div id="empty-selection" class="flex min-h-64 items-center justify-center text-center text-sm text-slate-500 dark:text-slate-400">
              Pilih diskusi pikeun maca komentar jeung ngabales.
            </div>
            <div id="thread-content" class="hidden">
              <div class="mb-5 border-b border-slate-200 pb-5 dark:border-slate-700">
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <span id="thread-status" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200"></span>
                  <span id="thread-number" class="font-mono text-xs text-slate-500 dark:text-slate-400"></span>
                </div>
                <h2 id="thread-title" class="font-bevan text-xl leading-snug sm:text-2xl"></h2>
                <a id="thread-article" class="mt-3 inline-block break-all text-sm font-semibold text-[#1B4B66] underline decoration-dotted underline-offset-4 hover:text-[#E8935B] dark:text-[#7BB4D1]" target="_blank" rel="noreferrer"></a>
              </div>

              <div id="comment-list" class="space-y-4"></div>

              <form id="reply-form" class="mt-7 border-t border-slate-200 pt-5 dark:border-slate-700">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <label for="reply-body" class="font-semibold">Tulis balasan</label>
                  <button id="cancel-reply" type="button" class="hidden text-xs font-semibold text-slate-500 underline hover:text-[#E8935B]">Batal ngabales komentar</button>
                </div>
                <p id="reply-context" class="mb-2 hidden text-xs text-slate-500 dark:text-slate-400"></p>
                <textarea id="reply-body" rows="4" maxlength="20000" required placeholder="Tulis balasan di dieu..." class="w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 placeholder:text-slate-500 focus:border-[#1B4B66] focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-white"></textarea>
                <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                  <p class="text-xs text-slate-500 dark:text-slate-400">Balasan bakal dipasang minangka akun GitHub admin.</p>
                  <button id="send-reply" type="submit" class="rounded-lg bg-[#1B4B66] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#153a50] disabled:cursor-not-allowed disabled:opacity-60">Kirim balasan</button>
                </div>
              </form>
            </div>
          </section>
        </div>
      </section>

      <div id="blog-posts" class="hidden" data-posts={JSON.stringify(posts)}></div>
    </div>
  </section>
</Layout>

<script>
  type Author = { login: string } | null;
  type Comment = {
    id: string;
    body: string;
    createdAt: string;
    author: Author;
    replies?: { nodes: Comment[] };
  };
  type Discussion = {
    id: string;
    number: number;
    title: string;
    url: string;
    createdAt: string;
    updatedAt: string;
    isAnswered: boolean;
    author: Author;
    comments: { nodes: Comment[] };
  };
  type BlogPost = { path: string; title: string };

  const notice = document.querySelector<HTMLDivElement>('#admin-notice')!;
  const loginPanel = document.querySelector<HTMLElement>('#admin-login')!;
  const dashboard = document.querySelector<HTMLElement>('#admin-dashboard')!;
  const discussionList = document.querySelector<HTMLDivElement>('#discussion-list')!;
  const detailEmpty = document.querySelector<HTMLDivElement>('#empty-selection')!;
  const threadContent = document.querySelector<HTMLDivElement>('#thread-content')!;
  const commentList = document.querySelector<HTMLDivElement>('#comment-list')!;
  const searchInput = document.querySelector<HTMLInputElement>('#discussion-search')!;
  const replyForm = document.querySelector<HTMLFormElement>('#reply-form')!;
  const replyBody = document.querySelector<HTMLTextAreaElement>('#reply-body')!;
  const replyContext = document.querySelector<HTMLParagraphElement>('#reply-context')!;
  const cancelReplyButton = document.querySelector<HTMLButtonElement>('#cancel-reply')!;
  const sendReplyButton = document.querySelector<HTMLButtonElement>('#send-reply')!;
  const blogPosts = JSON.parse(document.querySelector<HTMLDivElement>('#blog-posts')!.dataset.posts || '[]') as BlogPost[];

  let discussions: Discussion[] = [];
  let selectedDiscussionId = '';
  let replyToId = '';
  let replyToLogin = '';

  const loginMessages: Record<string, string> = {
    state: 'Login teu hasil divalidasi. Mangga cobian deui.',
    denied: 'Otorisasi GitHub dibatalkeun.',
    code: 'GitHub teu ngirim kode login anu diperlukeun.',
    token: 'Token GitHub teu hasil dijieun. Pariksa setélan GitHub App.',
    'not-allowed': 'Akun ieu teu diidinan ngatur komentar.',
    connection: 'Teu bisa nyambung ka GitHub. Cobian deui.',
  };

  function showNotice(message: string, kind: 'info' | 'error' = 'info') {
    notice.textContent = message;
    notice.className = kind === 'error'
      ? 'mb-5 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/50 dark:text-red-200'
      : 'mb-5 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900 dark:border-sky-900 dark:bg-sky-950/50 dark:text-sky-100';
  }

  function clearNotice() {
    notice.textContent = '';
    notice.className = 'mb-5 hidden rounded-xl border px-4 py-3 text-sm';
  }

  function postForDiscussion(discussion: Discussion) {
    try {
      const decoded = decodeURIComponent(discussion.title);
      const path = decoded.startsWith('http') ? new URL(decoded).pathname : decoded.split(/[?#]/)[0];
      return blogPosts.find((post) => post.path === path);
    } catch {
      return undefined;
    }
  }

  function discussionTitle(discussion: Discussion) {
    const post = postForDiscussion(discussion);
    if (post) return post.title;
    try {
      return decodeURIComponent(discussion.title);
    } catch {
      return discussion.title;
    }
  }

  function formatDate(value: string) {
    return new Intl.DateTimeFormat('id-ID', {
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(value));
  }

  function makeElement<K extends keyof HTMLElementTagNameMap>(tag: K, className = '') {
    const element = document.createElement(tag);
    if (className) element.className = className;
    return element;
  }

  function allCommentsCount(discussion: Discussion) {
    return discussion.comments.nodes.reduce((count, comment) => count + 1 + (comment.replies?.nodes.length ?? 0), 0);
  }

  function renderDiscussionList() {
    discussionList.replaceChildren();
    const filter = searchInput.value.trim().toLocaleLowerCase('id-ID');
    const filtered = discussions.filter((discussion) => discussionTitle(discussion).toLocaleLowerCase('id-ID').includes(filter));

    if (filtered.length === 0) {
      const empty = makeElement('p', 'px-3 py-8 text-center text-sm text-slate-500 dark:text-slate-400');
      empty.textContent = discussions.length === 0 ? 'Can teu aya diskusi dina kategori Giscus.' : 'Teu aya diskusi nu cocog.';
      discussionList.append(empty);
      return;
    }

    for (const discussion of filtered) {
      const button = makeElement('button', 'mb-1 w-full rounded-xl px-3 py-3 text-left transition hover:bg-slate-100 dark:hover:bg-slate-800');
      button.type = 'button';
      button.setAttribute('role', 'option');
      button.setAttribute('aria-selected', String(discussion.id === selectedDiscussionId));
      if (discussion.id === selectedDiscussionId) button.classList.add('bg-sky-50', 'dark:bg-slate-800');

      const title = makeElement('span', 'block line-clamp-2 text-sm font-bold');
      title.textContent = discussionTitle(discussion);
      const meta = makeElement('span', 'mt-1 block text-xs text-slate-500 dark:text-slate-400');
      const count = allCommentsCount(discussion);
      meta.textContent = `${count} komentar · ${formatDate(discussion.updatedAt)}`;
      button.append(title, meta);
      button.addEventListener('click', () => {
        selectedDiscussionId = discussion.id;
        replyToId = '';
        replyToLogin = '';
        renderDiscussionList();
        renderSelectedDiscussion();
      });
      discussionList.append(button);
    }
  }

  function renderComment(comment: Comment, depth = 0) {
    const wrapper = makeElement('article', `rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/70${depth ? ' ml-5 sm:ml-8' : ''}`);
    const heading = makeElement('div', 'mb-2 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-xs');
    const author = makeElement('strong', 'text-slate-900 dark:text-slate-100');
    author.textContent = comment.author?.login ?? 'Pamaké GitHub';
    const date = makeElement('time', 'text-slate-500 dark:text-slate-400');
    date.dateTime = comment.createdAt;
    date.textContent = formatDate(comment.createdAt);
    heading.append(author, date);

    const body = makeElement('p', 'whitespace-pre-wrap break-words text-sm leading-7 text-slate-700 dark:text-slate-200');
    body.textContent = comment.body;
    wrapper.append(heading, body);

    const replyButton = makeElement('button', 'mt-3 text-xs font-bold text-[#1B4B66] underline underline-offset-4 hover:text-[#E8935B] dark:text-[#7BB4D1]');
    replyButton.type = 'button';
    replyButton.textContent = 'Balas';
    replyButton.addEventListener('click', () => {
      replyToId = comment.id;
      replyToLogin = comment.author?.login ?? 'pamaké ieu';
      updateReplyContext();
      replyBody.focus();
    });
    wrapper.append(replyButton);

    for (const child of comment.replies?.nodes ?? []) {
      wrapper.append(renderComment(child, depth + 1));
    }
    return wrapper;
  }

  function updateReplyContext() {
    const replying = Boolean(replyToId);
    replyContext.classList.toggle('hidden', !replying);
    cancelReplyButton.classList.toggle('hidden', !replying);
    replyContext.textContent = replying ? `Ngabales ${replyToLogin}.` : '';
  }

  function renderSelectedDiscussion() {
    const discussion = discussions.find((item) => item.id === selectedDiscussionId);
    if (!discussion) {
      detailEmpty.classList.remove('hidden');
      threadContent.classList.add('hidden');
      return;
    }

    detailEmpty.classList.add('hidden');
    threadContent.classList.remove('hidden');
    document.querySelector<HTMLSpanElement>('#thread-status')!.textContent = discussion.isAnswered ? 'Dijawab' : 'Teu acan dijawab';
    document.querySelector<HTMLSpanElement>('#thread-number')!.textContent = `Diskusi #${discussion.number}`;
    document.querySelector<HTMLHeadingElement>('#thread-title')!.textContent = discussionTitle(discussion);
    const articleLink = document.querySelector<HTMLAnchorElement>('#thread-article')!;
    const post = postForDiscussion(discussion);
    articleLink.href = post?.path ?? discussion.url;
    articleLink.textContent = post ? `Buka artikel: ${post.path}` : 'Buka diskusi dina GitHub';

    commentList.replaceChildren();
    if (discussion.comments.nodes.length === 0) {
      const empty = makeElement('p', 'rounded-xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-500 dark:bg-slate-950/70 dark:text-slate-400');
      empty.textContent = 'Can aya komentar dina diskusi ieu. Anjeun tiasa ngamimitian ku ngabales di handap.';
      commentList.append(empty);
    } else {
      for (const comment of discussion.comments.nodes) commentList.append(renderComment(comment));
    }
    updateReplyContext();
  }

  async function loadDiscussions(keepSelectedId = selectedDiscussionId) {
    clearNotice();
    discussionList.replaceChildren();
    const loading = makeElement('p', 'px-3 py-8 text-center text-sm text-slate-500 dark:text-slate-400');
    loading.textContent = 'Ngamuat diskusi...';
    discussionList.append(loading);

    try {
      const response = await fetch('/api/admin/giscus/discussions', { cache: 'no-store' });
      const result = await response.json() as { discussions?: Discussion[]; error?: string };
      if (response.status === 401) {
        dashboard.classList.add('hidden');
        loginPanel.classList.remove('hidden');
        showNotice(result.error ?? 'Mangga asup deui ku GitHub.', 'error');
        return;
      }
      if (!response.ok || !result.discussions) {
        showNotice(result.error ?? 'Diskusi teu hasil dimuat.', 'error');
        discussionList.replaceChildren();
        return;
      }

      discussions = result.discussions;
      selectedDiscussionId = discussions.some((item) => item.id === keepSelectedId)
        ? keepSelectedId
        : discussions[0]?.id ?? '';
      renderDiscussionList();
      renderSelectedDiscussion();
    } catch {
      discussionList.replaceChildren();
      showNotice('Teu bisa nyambung ka GitHub Discussions. Cobian muat deui.', 'error');
    }
  }

  searchInput.addEventListener('input', renderDiscussionList);
  document.querySelector<HTMLButtonElement>('#refresh-discussions')!.addEventListener('click', () => {
    void loadDiscussions();
  });

  document.querySelector<HTMLButtonElement>('#admin-logout')!.addEventListener('click', async () => {
    await fetch('/api/admin/giscus/session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: '{}',
    });
    dashboard.classList.add('hidden');
    loginPanel.classList.remove('hidden');
    discussions = [];
    selectedDiscussionId = '';
    showNotice('Anjeun geus kaluar.', 'info');
  });

  cancelReplyButton.addEventListener('click', () => {
    replyToId = '';
    replyToLogin = '';
    updateReplyContext();
  });

  replyForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const discussion = discussions.find((item) => item.id === selectedDiscussionId);
    const body = replyBody.value.trim();
    if (!discussion || !body) return;

    sendReplyButton.disabled = true;
    sendReplyButton.textContent = 'Ngirim...';
    clearNotice();
    try {
      const response = await fetch('/api/admin/giscus/discussions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          discussionId: discussion.id,
          replyToId: replyToId || undefined,
          body,
        }),
      });
      const result = await response.json() as { error?: string };
      if (response.status === 401) {
        dashboard.classList.add('hidden');
        loginPanel.classList.remove('hidden');
      }
      if (!response.ok) throw new Error(result.error ?? 'Balasan teu hasil dikirim.');
      replyBody.value = '';
      replyToId = '';
      replyToLogin = '';
      showNotice('Balasan geus dikirim ka GitHub Discussions.', 'info');
      await loadDiscussions(discussion.id);
    } catch (error) {
      showNotice(error instanceof Error ? error.message : 'Balasan teu hasil dikirim.', 'error');
    } finally {
      sendReplyButton.disabled = false;
      sendReplyButton.textContent = 'Kirim balasan';
    }
  });

  const loginReason = new URLSearchParams(window.location.search).get('login');
  if (loginReason && loginMessages[loginReason]) showNotice(loginMessages[loginReason], 'error');

  try {
    const response = await fetch('/api/admin/giscus/session', { cache: 'no-store' });
    const result = await response.json() as { authenticated?: boolean; login?: string; error?: string };
    if (result.authenticated && result.login) {
      document.querySelector<HTMLElement>('#admin-login-name')!.textContent = `@${result.login}`;
      dashboard.classList.remove('hidden');
      await loadDiscussions();
    } else {
      loginPanel.classList.remove('hidden');
      if (result.error) showNotice(result.error, 'error');
    }
  } catch {
    loginPanel.classList.remove('hidden');
    showNotice('Teu bisa nyambung ka jasa komentar. Muat deui halaman ieu.', 'error');
  }
</script>
