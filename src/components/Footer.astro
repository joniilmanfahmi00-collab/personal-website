---
import Link from '../components/Link.astro';
// Impor ikon ti astro-icon améh warnana tiasa di-style ku Tailwind
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();

// Supados rapih tur gampang di-manage, data sosial media disimpen dina array
const socialLinks = [
    { name: 'GitHub', url: 'https://github.com', icon: 'tabler:brand-github' },
    { name: 'LinkedIn', url: 'https://linkedin.com', icon: 'tabler:brand-linkedin' },
    { name: 'Instagram', url: 'https://instagram.com', icon: 'tabler:brand-instagram' },
    { name: 'TikTok', url: 'https://tiktok.com', icon: 'tabler:brand-tiktok' },
    { name: 'Twitter', url: 'https://twitter.com', icon: 'tabler:brand-twitter' },
];
---

<footer class="bg-white dark:bg-[#0B1220] border-t border-slate-200 dark:border-slate-800 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex flex-col items-center">
        
        <!-- Menu Navigasi -->
        <nav class="flex justify-center flex-wrap gap-x-8 gap-y-4 mb-8 text-sm font-semibold text-slate-600 dark:text-slate-300">
            <!-- Parameter cssClass disaluyukeun kana warna signature Aa -->
            <Link link="/" cssClass="hover:text-[#E8935B] dark:hover:text-[#E8935B] transition-colors" content="Beranda" />
            <Link link="/bio" cssClass="hover:text-[#E8935B] dark:hover:text-[#E8935B] transition-colors" content="Profil" />
            <Link link="/blog" cssClass="hover:text-[#E8935B] dark:hover:text-[#E8935B] transition-colors" content="Blog" />
        </nav>

        <!-- Social Media Icons -->
        <div class="flex justify-center space-x-6 mb-8">
            {socialLinks.map((social) => (
                <a 
                    href={social.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-slate-400 hover:text-[#1B4B66] dark:hover:text-[#7BB4D1] transition-all transform hover:-translate-y-1 duration-200" 
                    aria-label={social.name}
                >
                    <Icon name={social.icon} class="w-6 h-6" />
                </a>
            ))}
        </div>
        
        <!-- Copyright & Signature -->
        <div class="flex flex-col items-center gap-3">
            <!-- Aksen gurat leutik pemanis -->
            <div class="w-12 h-1 bg-[#E8935B]/40 rounded-full"></div>
            
            <p class="font-sans text-sm text-slate-500 dark:text-slate-400 text-center">
                &copy; {currentYear} <span class="font-semibold text-[#1B4B66] dark:text-[#7BB4D1]">Joni Ilman Pahmi</span>. Seluruh hak cipta dilindungi undang-undang.
            </p>
            
            <!-- Tambahan alit sangkan katingali pisan vibe developer-na -->
            <p class="font-mono text-xs text-slate-400/60 dark:text-slate-500/60">
                // Sistem beroperasi dan siap melayani.
            </p>
        </div>
        
    </div>
</footer>